#!name=QLING
#!desc=NOTHING
#!author=Wazue.site
#!moduleUrl=https://github.com/qling7588/locket/raw/refs/heads/main/stable.sgmodule

[Script]
qling4_status = type=http-request, pattern=^http://qling-status\.invalid/(?:status|report\.json)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/qling7588/locket/refs/heads/main/p_4.0.5-14be5023c96d/deobfuscated.js, timeout=10
qling4_https = type=http-request, pattern=^https://(?:api\.revenuecat\.com|firebaseremoteconfig\.googleapis\.com)/qling-check(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/qling7588/locket/refs/heads/main/p_4.0.5-14be5023c96d/deobfuscated.js, timeout=10
qling4_request = type=http-request, pattern=^https://(?:(?:api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)/(?:v1|v2)/(?:receipts|subscribers)(?:[/?]|$)|firebaseremoteconfig\.googleapis\.com/v1/projects/[^/?#]+/namespaces/[^/?#]+:fetch/?(?:\?[^#]*)?$), script-path=https://raw.githubusercontent.com/qling7588/locket/refs/heads/main/p_4.0.5-14be5023c96d/deobfuscated.js, timeout=10
qling4_revenuecat = type=http-response, pattern=^https://(?:api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)/(?:v1|v2)/(?:receipts|subscribers)(?:[/?]|$), script-path=https://raw.githubusercontent.com/qling7588/locket/refs/heads/main/p_4.0.5-14be5023c96d/deobfuscated.js, requires-body=true, max-size=1048576, timeout=10
qling4_firebase = type=http-response, pattern=^https://firebaseremoteconfig\.googleapis\.com/v1/projects/(?:locket-4252a|869942740286)/namespaces/firebase:fetch/?(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/qling7588/locket/refs/heads/main/p_4.0.5-14be5023c96d/deobfuscated.js, argument=aura-frame, requires-body=true, max-size=1048576, timeout=10

[Host]
qling-status.invalid = 198.18.0.1

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-production.8-lives-cat.io, firebaseremoteconfig.googleapis.com
